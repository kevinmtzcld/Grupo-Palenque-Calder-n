----------------------------------------------------------------------------
***SEMANTICO: FUNCION SE LLAMA ASI MISMA
----------------------------------------------------------------------------
racional x = 1/2, limite = 5/2;

def incrementar() {
    si (x < limite) {
        x = x + 1/2;
        incrementar();
    }
    retornar (x);
}

principal() {
    incrementar();
    mostrar("Resultado final: ", x);
}
