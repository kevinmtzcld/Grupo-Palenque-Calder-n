--------------------------------------------------------------
3. overflow supera los 32 bits
--------------------------------------------------------------
racional x = 1000000/1, factor = 1000000/1;

principal() {
    mientras (x > 0/1) {
        x = x * factor;
        mostrar("Valor actual: ", x);
    }
}



