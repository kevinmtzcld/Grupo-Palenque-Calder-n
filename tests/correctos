2)**********************resultado desaprobado 3,5<4



racional nota = 7/2, minimo = 4/1;

principal() {
    si (nota >= minimo) {
        mostrar("Aprobado con: ", nota);
    } sino {
        mostrar("Desaprobado con: ", nota);
    }
}





